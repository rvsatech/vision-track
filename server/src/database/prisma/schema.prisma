generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum InspectionStatus {
  PROCESSING
  SUCCESS
  FAILED
}

//////////////////////////////////////////////////////
// PLANS
//////////////////////////////////////////////////////

model Plan {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  description String?

  companies   Company[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

//////////////////////////////////////////////////////
// COMPANIES (TENANTS)
//////////////////////////////////////////////////////

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  cnpj        String?  @unique

  planId      Int?
  plan        Plan?    @relation(fields: [planId], references: [id])

  users       User[]
  uploads     Upload[]
  inspections Inspection[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([planId])
}

//////////////////////////////////////////////////////
// USERS
//////////////////////////////////////////////////////

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String

  role        Role     @default(USER)

  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])

  uploads     Upload[]
  inspections Inspection[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

//////////////////////////////////////////////////////
// UPLOADS (OPTIONAL MVP USO FUTURO)
//////////////////////////////////////////////////////

model Upload {
  id          Int      @id @default(autoincrement())

  url         String
  filename    String

  size        Int?
  mimeType    String?

  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])

  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])

  inspections Inspection[]

  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([userId])
}

//////////////////////////////////////////////////////
// INSPECTIONS (ROBOFLOW MVP READY)
//////////////////////////////////////////////////////

model Inspection {
  id          Int      @id @default(autoincrement())

  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])

  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])

  uploadId    Int?
  upload      Upload?  @relation(fields: [uploadId], references: [id])

  status      InspectionStatus

  resultJson  Json

  confidence  Float?
  inferenceMs Int?

  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([uploadId])
}